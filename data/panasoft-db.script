CREATE MEMORY TABLE PUBLIC.PAN(CODIGO INTEGER NOT NULL PRIMARY KEY,DESCRIPCION VARCHAR(255),IMAGEN VARCHAR(50),NOMBRE VARCHAR(50),PRECIO NUMERIC(19,2),STOCK INTEGER,TAMA\u00d1O_NOMBRE VARCHAR(20),TIPOMASA_NOMBRE VARCHAR(20))
