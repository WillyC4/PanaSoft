CREATE MEMORY TABLE PUBLIC.TAMANIOPAN(NOMBRE VARCHAR(20) NOT NULL PRIMARY KEY)
CREATE MEMORY TABLE PUBLIC.TIPOMASA(NOMBRE VARCHAR(20) NOT NULL PRIMARY KEY)
CREATE MEMORY TABLE PUBLIC.VENTAPAN(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CANTIDADVENDIDA INTEGER NOT NULL,FECHA DATE,PAN_CODIGO INTEGER,CONSTRAINT FK42GSGAS66YX1YFOP2YI4WAEFO FOREIGN KEY(PAN_CODIGO) REFERENCES PUBLIC.PAN(CODIGO))
ALTER TABLE PUBLIC.VENTAPAN ALTER COLUMN ID RESTART WITH 1
